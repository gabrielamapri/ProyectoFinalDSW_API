# Database (used to construct ConnectionStrings__DefaultConnection)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CentroTerapiaDb
DB_USER=root
DB_PASSWORD=your_db_password

# JWT settings
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ISSUER=CentroTerapia
JWT_AUDIENCE=CentroTerapiaClientes

# Optional: example explicit connection string (Program.cs will build it from DB_* if missing)
# ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=CentroTerapiaDb;User=root;Password=your_db_password;